# Copy to .env.migrations and set an explicit SQLite database URL.
# The parent directory must exist. Keep live databases outside the Markdown
# vault, source tree, and cloud-sync directories. Quote paths containing spaces.
# Example: HIPPO_MIGRATION_DATABASE_URL="sqlite:/absolute/path/hippo.sqlite3"
# An exported variable with the same name overrides this value.
# Use literal, single-line values; no variable expansion or multiline values.
# SQLite file URLs with hosts, queries, fragments, or %, ?, # in the decoded
# file path are unsupported by the preflight check.
HIPPO_MIGRATION_DATABASE_URL=

# Directory containing numbered .sql files. Relative paths use the repository root.
# This is the SQL source directory, not the database file or Obsidian docs folder.
# An exported MIGRATION_SRC_PATH overrides this value.
MIGRATION_SRC_PATH="database/migrations"
