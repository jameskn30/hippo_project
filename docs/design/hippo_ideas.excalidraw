      "seed": 1676934990,
      "version": 536,
      "versionNonce": 1956586002,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791654394606,
      "created": 1791654173861,
      "link": null,
      "locked": false,
      "text": "func req\n- local storage, scale up to 10k notes\n- core service knows location of different vaults\n- CRUD ops will trigger ingestion\n- hippo push doc updates to core service\n- ELT pipeline will take raw doc, process and store in db\n- core service will publish events so downstream components can react\n- perform backup, retention policy",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "func req\n- local storage, scale up to 10k notes\n- core service knows location of different vaults\n- CRUD ops will trigger ingestion\n- hippo push doc updates to core service\n- ELT pipeline will take raw doc, process and store in db\n- core service will publish events so downstream components can react\n- perform backup, retention policy",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
