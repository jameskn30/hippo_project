    {
      "id": "qxQWkNt2obAH4ETXZcLMw",
      "type": "text",
      "x": -636.0347009922281,
      "y": 1482.0818039841945,
      "width": 683.2196044921875,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0U",
